{
  "name": "@aind/mipmap-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Browser reader and viewer for ecephys mipmap Zarr stores",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --open /src/app/index.html",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "fixtures": "cd .. && uv run python -I scripts/make_fixtures.py"
  },
  "dependencies": {
    "zarrita": "0.7.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@zarrita/storage": "0.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
